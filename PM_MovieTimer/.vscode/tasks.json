{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Sketch",
      "type": "shell",
      "command": "/usr/local/bin/processing-java",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "args": [
        "--force",
        "--sketch=${fileDirname}",
        "--run"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}